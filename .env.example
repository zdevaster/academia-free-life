# Copie para .env se quiser configurar sem exportar variáveis no shell.
# O site sobe sem este arquivo: a senha padrão e a porta abaixo são as mesmas do código.

PORT=47231
HOST=0.0.0.0

# Senha do /admin. Em desenvolvimento, vazio usa freelife-admin.
# Em produção (NODE_ENV=production), vazio NÃO usa essa senha: o processo gera
# uma senha aleatória e a imprime no log. Troque antes de publicar.
ADMIN_PASSWORD=freelife-admin

# Chave da sessão. Troque por um texto longo e aleatório antes de publicar.
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# 1 somente com HTTPS (atrás de proxy). Em HTTP local, deixe vazio.
COOKIE_SECURE=

# 1 somente atrás de um proxy reverso de confiança (Caddy, nginx).
# Sem isso, o site ignora X-Forwarded-For no limite de tentativas de login.
TRUST_PROXY=

# Telefone com DDD. Vazio oculta o botão Ligar.
# Se preenchido, tem prioridade sobre o valor salvo no painel.
PHONE=

# WhatsApp: celular com DDD, só números (o 55 do Brasil é opcional).
# Vazio oculta o botão. Se preenchido, tem prioridade sobre o painel.
WHATSAPP=

# Opcional. Padrão: data/freelife.sqlite
# DB_PATH=./data/freelife.sqlite

NODE_ENV=development
